enum IssueState {
  OPEN   @map("open")
  CLOSED @map("closed")
}

model Issue {
  issueId           String           @id @default(uuid()) @map("issue_id") @db.Uuid
  repositoryId      String           @map("repository_id") @db.Uuid
  githubIssueNumber Int              @map("github_issue_number")
  title             String
  body              String?
  status            IssueState
  authorLogin       String?          @map("author_login")
  assigneeLogin     String?          @map("assignee_login")
  createdAt         DateTime?        @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?        @map("updated_at") @db.Timestamptz(6)
  closedAt          DateTime?        @map("closed_at") @db.Timestamptz(6)
  syncedAt          DateTime         @map("synced_at") @db.Timestamptz(6)
  repository        GithubRepository @relation(fields: [repositoryId], references: [repositoryId], onDelete: Cascade)

  @@unique([repositoryId, githubIssueNumber])
  @@map("issues")
}
