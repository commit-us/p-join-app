model ProjectTechStack {
  projectId    String    @map("project_id") @db.Uuid
  techStackId  String    @map("tech_stack_id") @db.Uuid
  displayOrder Int       @default(0) @map("display_order")
  project      Project   @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  techStack    TechStack @relation(fields: [techStackId], references: [techStackId], onDelete: Restrict)

  @@id([projectId, techStackId])
  @@index([techStackId, projectId])
  @@map("project_tech_stacks")
}
