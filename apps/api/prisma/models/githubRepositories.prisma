enum GithubRepositoryStatus {
  CONNECTED    @map("connected")
  EXPIRED      @map("expired")
  DISCONNECTED @map("disconnected")
  ERROR        @map("error")
}

enum GithubRepositoryVisibility {
  PRIVATE  @map("private")
  PUBLIC   @map("public")
  INTERNAL @map("internal")
}

model GithubRepository {
  repositoryId       String                      @id @default(uuid()) @map("repository_id") @db.Uuid
  projectId          String                      @map("project_id") @db.Uuid
  externalAccountId  String?                     @map("external_account_id") @db.Uuid
  githubRepositoryId String                      @map("github_repository_id")
  fullName           String                      @map("full_name")
  defaultBranch      String?                     @map("default_branch")
  htmlUrl            String?                     @map("html_url")
  visibility         GithubRepositoryVisibility?
  syncStatus         GithubRepositoryStatus      @default(CONNECTED) @map("sync_status")
  connectedAt        DateTime?                   @map("connected_at") @db.Timestamptz(6)
  disconnectedAt     DateTime?                   @map("disconnected_at") @db.Timestamptz(6)
  lastSyncedAt       DateTime?                   @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  project            Project                     @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  externalAccount    UserExternalAccount?        @relation(fields: [externalAccountId], references: [externalAccountId], onDelete: SetNull)
  activities         GithubActivity[]
  issues             Issue[]
  pullRequests       PullRequest[]

  @@unique([projectId])
  @@unique([githubRepositoryId])
  @@map("github_repositories")
}
