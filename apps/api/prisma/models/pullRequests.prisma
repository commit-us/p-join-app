enum PullRequestState {
  OPEN   @map("open")
  CLOSED @map("closed")
  MERGED @map("merged")
}

model PullRequest {
  pullRequestId  String              @id @default(uuid()) @map("pull_request_id") @db.Uuid
  repositoryId   String              @map("repository_id") @db.Uuid
  githubPrNumber Int                 @map("github_pr_number")
  authorId       String              @map("author_id") @db.Uuid
  authorLogin    String              @map("author_login")
  title          String
  body           String?
  baseBranch     String              @map("base_branch")
  headBranch     String              @map("head_branch")
  status         PullRequestState
  headCommitSha  String              @map("head_commit_sha")
  createdAt      DateTime?           @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?           @map("updated_at") @db.Timestamptz(6)
  mergedAt       DateTime?           @map("merged_at") @db.Timestamptz(6)
  syncedAt       DateTime            @map("synced_at") @db.Timestamptz(6)
  reviewRequests Json                @default("[]") @map("review_requests")
  repository     GithubRepository    @relation(fields: [repositoryId], references: [repositoryId], onDelete: Cascade)
  author         User                @relation("PullRequestAuthor", fields: [authorId], references: [userId], onDelete: Restrict)
  reviews        PullRequestReview[]

  @@unique([repositoryId, githubPrNumber])
  @@index([repositoryId, status, updatedAt])
  @@map("pull_requests")
}
