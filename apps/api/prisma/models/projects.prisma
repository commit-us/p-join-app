enum ProjectLifecycleStatus {
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  STOPPED   @map("stopped")
}

model Project {
  projectId          String                 @id @default(uuid()) @map("project_id") @db.Uuid
  ownerId            String                 @map("owner_id") @db.Uuid
  title              String
  description        String
  detailTitle        String?                @map("detail_title")
  detailDescription  String?                @map("detail_description")
  coverImageUrl      String?                @map("cover_image_url")
  recruitmentStartAt DateTime?              @map("recruitment_start_at") @db.Timestamptz(6)
  recruitmentEndAt   DateTime?              @map("recruitment_end_at") @db.Timestamptz(6)
  lifecycleStatus    ProjectLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  version            Int                    @default(1)
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(6)
  weeklyGoals        Json?                  @map("weekly_goals")
  goalsUpdatedBy     String?                @map("goals_updated_by") @db.Uuid
  goalsUpdatedAt     DateTime?              @map("goals_updated_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner              User                   @relation("ProjectOwner", fields: [ownerId], references: [userId], onDelete: Restrict)
  goalsUpdater       User?                  @relation("ProjectGoalUpdater", fields: [goalsUpdatedBy], references: [userId], onDelete: SetNull)
  applications       Application[]
  members            ProjectMember[]
  likes              Like[]
  bookmarks          Bookmark[]
  schedules          Schedule[]
  repository         GithubRepository?
  projectTechStacks  ProjectTechStack[]

  @@index([ownerId, createdAt])
  @@index([lifecycleStatus, recruitmentEndAt])
  @@map("projects")
}
