model TechStack {
  techStackId       String             @id @default(uuid()) @map("tech_stack_id") @db.Uuid
  name              String             @unique
  searchKeywords    String?            @map("search_keywords")
  officialLogoUrl   String?            @map("official_logo_url")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  projectTechStacks ProjectTechStack[]

  @@map("tech_stacks")
}
