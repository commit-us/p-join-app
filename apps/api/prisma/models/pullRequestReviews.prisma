enum PullRequestReviewResult {
  APPROVED          @map("approved")
  CHANGES_REQUESTED @map("changes_requested")
}

model PullRequestReview {
  reviewId          String                  @id @default(uuid()) @map("review_id") @db.Uuid
  pullRequestId     String                  @map("pull_request_id") @db.Uuid
  githubReviewId    String?                 @unique @map("github_review_id")
  reviewerId        String                  @map("reviewer_id") @db.Uuid
  reviewerLogin     String                  @map("reviewer_login")
  status            PullRequestReviewResult
  comment           String?
  reviewedCommitSha String                  @map("reviewed_commit_sha")
  submittedAt       DateTime                @map("submitted_at") @db.Timestamptz(6)
  syncedAt          DateTime                @map("synced_at") @db.Timestamptz(6)
  pullRequest       PullRequest             @relation(fields: [pullRequestId], references: [pullRequestId], onDelete: Cascade)
  reviewer          User                    @relation("PullRequestReviewer", fields: [reviewerId], references: [userId], onDelete: Restrict)

  @@index([pullRequestId, submittedAt])
  @@map("pull_request_reviews")
}
